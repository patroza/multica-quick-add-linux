#!/usr/bin/env bash
# Multica Quick Add — Walker/Elephant (Linux) fork of
# https://github.com/tim-smart/multica-quick-add
#
# Global-hotkey capture + Elephant hub for workspace/project/agent selection.

set -euo pipefail

# Resolve through symlinks (install puts ~/.local/bin/multica-quick-add → repo/bin/…).
_mqa_src="${BASH_SOURCE[0]}"
while [[ -L "$_mqa_src" ]]; do
  _mqa_dir="$(cd -P "$(dirname "$_mqa_src")" && pwd)"
  _mqa_src="$(readlink "$_mqa_src")"
  [[ "$_mqa_src" != /* ]] && _mqa_src="$_mqa_dir/$_mqa_src"
done
MQA_ROOT="$(cd -P "$(dirname "$_mqa_src")/.." && pwd)"
unset _mqa_src _mqa_dir
# shellcheck source=../lib/multica-quick-add.sh
source "$MQA_ROOT/lib/multica-quick-add.sh"

usage() {
  cat <<'EOF'
Multica Quick Add

USAGE
  multica-quick-add --panel          # Quickshell floating panel (default)
  multica-quick-add --panel-gtk      # GTK4 comparison panel
  multica-quick-add --panel-qs       # Alias for --panel
  multica-quick-add --hub            # Walker/Elephant hub (legacy)
  multica-quick-add [flags] [prompt...]

FLAGS
  --panel                Open Quickshell panel (toggle if daemon running)
  --panel-gtk            Open GTK4/Adwaita panel
  --panel-qs             Alias for --panel
  --hub                  Open Walker/Elephant Multica hub
  --pick                 Force CLI pickers then prompt
  --configure            Interactive pickers; save only
  --refresh              Refresh Multica catalog cache
  --print-selection      JSON of current selection
  --set-workspace-id ID  Save workspace
  --set-project-id ID    Save project (empty / __none__ clears)
  --set-agent-id ID      Save created-by agent
  --set-squad-id ID      Save created-by squad
  --reopen-hub           After --set-*, reopen Walker hub
  --workspace-id ID      Override workspace for this run
  --project-id ID        Override project for this run
  --agent-id ID          Submit as this agent
  --squad-id ID          Submit as this squad
  --created-by NAME      Fuzzy agent/squad name
  --attachment PATH      Attach a file (repeatable)
  --no-notify            Print result to stdout instead of notify-send
  -h, --help             Show this help

Requires: multica CLI logged in, jq, curl. Panels need Quickshell or GTK4.
EOF
}

PICK=0
CONFIGURE=0
REFRESH=0
NO_NOTIFY=0
HUB=0
PANEL=0
PANEL_GTK=0
PANEL_QS=0
PRINT_SELECTION=0
REOPEN_HUB=0
SET_WORKSPACE_ID=""
SET_PROJECT_ID=""
SET_PROJECT=0
SET_AGENT_ID=""
SET_SQUAD_ID=""
WORKSPACE_ID=""
PROJECT_ID=""
PROJECT_ID_SET=0
AGENT_ID=""
SQUAD_ID=""
CREATED_BY_NAME=""
PROMPT_ARGS=()
ATTACHMENTS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --panel)
      PANEL=1
      shift
      ;;
    --panel-gtk)
      PANEL_GTK=1
      shift
      ;;
    --panel-qs)
      PANEL_QS=1
      shift
      ;;
    --hub)
      HUB=1
      shift
      ;;
    --pick)
      PICK=1
      shift
      ;;
    --configure)
      CONFIGURE=1
      PICK=1
      shift
      ;;
    --refresh)
      REFRESH=1
      shift
      ;;
    --print-selection)
      PRINT_SELECTION=1
      shift
      ;;
    --set-workspace-id)
      SET_WORKSPACE_ID="${2:?}"
      shift 2
      ;;
    --set-project-id)
      SET_PROJECT=1
      SET_PROJECT_ID="${2-}"
      shift 2
      ;;
    --set-agent-id)
      SET_AGENT_ID="${2:?}"
      shift 2
      ;;
    --set-squad-id)
      SET_SQUAD_ID="${2:?}"
      shift 2
      ;;
    --reopen-hub)
      REOPEN_HUB=1
      shift
      ;;
    --workspace-id)
      WORKSPACE_ID="${2:?}"
      shift 2
      ;;
    --project-id)
      PROJECT_ID="${2-}"
      PROJECT_ID_SET=1
      shift 2
      ;;
    --agent-id)
      AGENT_ID="${2:?}"
      shift 2
      ;;
    --squad-id)
      SQUAD_ID="${2:?}"
      shift 2
      ;;
    --created-by)
      CREATED_BY_NAME="${2:?}"
      shift 2
      ;;
    --attachment)
      ATTACHMENTS+=("${2:?}")
      shift 2
      ;;
    --no-notify)
      NO_NOTIFY=1
      shift
      ;;
    --)
      shift
      PROMPT_ARGS+=("$@")
      break
      ;;
    -*)
      mqa_die "Unknown flag: $1"
      ;;
    *)
      PROMPT_ARGS+=("$1")
      shift
      ;;
  esac
done

mqa_require_cmd jq
mqa_ensure_dirs

if [[ "$PANEL" == "1" || "$PANEL_QS" == "1" ]]; then
  mqa_open_panel_qs
  exit 0
fi
if [[ "$PANEL_GTK" == "1" ]]; then
  mqa_open_panel_gtk
  exit 0
fi
if [[ "$HUB" == "1" ]]; then
  mqa_open_hub
  exit 0
fi

# Soft config load for selection helpers (menus still work offline of API with cache).
_mqa_config_ok=0
if [[ -f "$MQA_CONFIG_PATH" ]]; then
  if mqa_load_config 2>/dev/null; then
    _mqa_config_ok=1
  fi
fi

# --- pure selection mutations (Elephant submenus) ---
if [[ -n "$SET_WORKSPACE_ID" || "$SET_PROJECT" == "1" || -n "$SET_AGENT_ID" || -n "$SET_SQUAD_ID" ]]; then
  mqa_require_cmd multica curl
  [[ "$_mqa_config_ok" == "1" ]] || mqa_die "Not logged in. Run multica login first."
  if [[ -n "$SET_WORKSPACE_ID" ]]; then
    mqa_set_workspace "$SET_WORKSPACE_ID"
  fi
  if [[ "$SET_PROJECT" == "1" ]]; then
    mqa_set_project "" "$SET_PROJECT_ID"
  fi
  if [[ -n "$SET_AGENT_ID" ]]; then
    mqa_set_created_by agent "$SET_AGENT_ID" ""
  fi
  if [[ -n "$SET_SQUAD_ID" ]]; then
    mqa_set_created_by squad "$SET_SQUAD_ID" ""
  fi
  if [[ "$NO_NOTIFY" != "1" ]]; then
    sel="$(mqa_print_selection)"
    name="$(jq -r '.created_by_name // "—"' <<<"$sel")"
    proj="$(jq -r '.project_title // "No project"' <<<"$sel")"
    ws="$(jq -r '.workspace_name // "—"' <<<"$sel")"
    mqa_notify "Multica selection" "$ws · $proj · $name"
  fi
  if [[ "$REOPEN_HUB" == "1" ]]; then
    mqa_reopen_hub
  fi
  if [[ "$NO_NOTIFY" == "1" ]]; then
    mqa_print_selection
  fi
  exit 0
fi

if [[ "$PRINT_SELECTION" == "1" ]]; then
  if [[ "$_mqa_config_ok" != "1" ]]; then
    jq -n '{
      ready: false,
      error: "not logged in",
      workspace_id: "",
      workspace_name: "",
      project_id: "",
      project_title: "No project",
      created_by_kind: "",
      created_by_id: "",
      created_by_name: "Not set",
      hint: "Run multica login"
    }'
    exit 0
  fi
  mqa_print_selection
  exit 0
fi

mqa_require_cmd multica curl
[[ "$_mqa_config_ok" == "1" ]] || mqa_die "Not logged in. Run multica login first."

# --- resolve workspace ---
if [[ -z "$WORKSPACE_ID" ]]; then
  WORKSPACE_ID="$(mqa_state_get last_workspace_id)"
fi
if [[ -z "$WORKSPACE_ID" && -n "${MQA_DEFAULT_WORKSPACE_ID:-}" ]]; then
  WORKSPACE_ID="$MQA_DEFAULT_WORKSPACE_ID"
fi

# Bare --refresh must never open interactive pickers (Elephant warms cache this way).
if [[ "$REFRESH" == "1" && "$CONFIGURE" != "1" && "$PICK" != "1" && ${#PROMPT_ARGS[@]} -eq 0 && -t 0 ]]; then
  if [[ -z "$WORKSPACE_ID" ]]; then
    WORKSPACE_ID="$(mqa_list_workspaces | jq -r '.[0].id // empty' 2>/dev/null || true)"
  fi
  if [[ -z "$WORKSPACE_ID" ]]; then
    exit 0
  fi
  mqa_get_catalog "$WORKSPACE_ID" 1 >/dev/null
  mqa_state_set last_workspace_id "$WORKSPACE_ID"
  if [[ "$NO_NOTIFY" == "1" ]]; then
    printf 'refreshed catalog for %s\n' "$WORKSPACE_ID"
  fi
  exit 0
fi

if [[ "$PICK" == "1" || -z "$WORKSPACE_ID" ]]; then
  mapfile -t ws_lines < <(mqa_list_workspaces | mqa_workspace_lines)
  if [[ ${#ws_lines[@]} -eq 0 ]]; then
    mqa_die "No Multica workspaces found."
  fi
  if [[ ${#ws_lines[@]} -eq 1 && -z "$WORKSPACE_ID" ]]; then
    WORKSPACE_ID="${ws_lines[0]##*$'\t'}"
  elif [[ "$PICK" == "1" || -z "$WORKSPACE_ID" ]]; then
    WORKSPACE_ID="$(mqa_pick_id_from_labeled "Multica workspace" "${ws_lines[@]}")" \
      || mqa_die "Cancelled."
  fi
fi
mqa_state_set last_workspace_id "$WORKSPACE_ID"

# --- catalog ---
if [[ "$REFRESH" == "1" ]]; then
  catalog="$(mqa_get_catalog "$WORKSPACE_ID" 1)"
else
  catalog="$(mqa_get_catalog "$WORKSPACE_ID" 0)"
  (mqa_get_catalog "$WORKSPACE_ID" 1 >/dev/null 2>&1 || true) &
fi

# --- project ---
if [[ "$PROJECT_ID_SET" != "1" ]]; then
  PROJECT_ID="$(mqa_ws_get "$WORKSPACE_ID" project_id)"
  [[ -n "$PROJECT_ID" ]] || PROJECT_ID="$(mqa_state_get "last_project_id.$WORKSPACE_ID")"
fi
if [[ "$PICK" == "1" ]]; then
  mapfile -t project_lines < <(printf '%s' "$catalog" | mqa_project_lines)
  project_lines=("— No project"$'\t'"__none__" "${project_lines[@]+"${project_lines[@]}"}")
  picked="$(mqa_pick_id_from_labeled "Multica project (optional)" "${project_lines[@]}")" || true
  PROJECT_ID="$(mqa_normalize_project_id "${picked:-}")"
else
  PROJECT_ID="$(mqa_normalize_project_id "${PROJECT_ID:-}")"
fi
mqa_ws_set "$WORKSPACE_ID" project_id "${PROJECT_ID:-}"

# --- created-by (agent | squad) ---
CREATED_BY_KIND=""
CREATED_BY_ID=""
CREATED_BY_NAME_RESOLVED=""

if [[ -n "$AGENT_ID" ]]; then
  CREATED_BY_KIND="agent"
  CREATED_BY_ID="$AGENT_ID"
elif [[ -n "$SQUAD_ID" ]]; then
  CREATED_BY_KIND="squad"
  CREATED_BY_ID="$SQUAD_ID"
elif [[ -n "$CREATED_BY_NAME" ]]; then
  match="$(
    printf '%s' "$catalog" | jq -r --arg n "$CREATED_BY_NAME" '
      (($n | ascii_downcase) as $q |
        ((.agents // []) | map(select((.name // "") | ascii_downcase | contains($q))) | .[0] | select(.) | "agent\t\(.id)\t\(.name)"),
         ((.squads // []) | map(select((.name // "") | ascii_downcase | contains($q))) | .[0] | select(.) | "squad\t\(.id)\t\(.name)"))
      ) // empty
    '
  )"
  [[ -n "$match" ]] || mqa_die "No agent/squad matching \"$CREATED_BY_NAME\""
  IFS=$'\t' read -r CREATED_BY_KIND CREATED_BY_ID CREATED_BY_NAME_RESOLVED <<<"$match"
else
  last_kind="$(mqa_ws_get "$WORKSPACE_ID" created_by_kind)"
  last_id="$(mqa_ws_get "$WORKSPACE_ID" created_by_id)"
  if [[ -z "$last_kind" || -z "$last_id" ]]; then
    last_kind="$(mqa_state_get "last_created_by_kind.$WORKSPACE_ID")"
    last_id="$(mqa_state_get "last_created_by_id.$WORKSPACE_ID")"
  fi
  if [[ "$PICK" == "1" || -z "$last_kind" || -z "$last_id" ]]; then
    mapfile -t cb_lines < <(printf '%s' "$catalog" | mqa_created_by_lines)
    [[ ${#cb_lines[@]} -gt 0 ]] || mqa_die "No agents or squads in this workspace."
    line="$(mqa_pick_line "Send to agent / squad" "${cb_lines[@]}")" || mqa_die "Cancelled."
    CREATED_BY_KIND="$(printf '%s' "$line" | cut -f2)"
    CREATED_BY_ID="$(printf '%s' "$line" | cut -f3)"
    CREATED_BY_NAME_RESOLVED="$(printf '%s' "$line" | cut -f1 | sed 's/^[🤖👥] //')"
  else
    CREATED_BY_KIND="$last_kind"
    CREATED_BY_ID="$last_id"
    CREATED_BY_NAME_RESOLVED="$(mqa_ws_get "$WORKSPACE_ID" created_by_name)"
    [[ -n "$CREATED_BY_NAME_RESOLVED" ]] || CREATED_BY_NAME_RESOLVED="$(mqa_state_get "last_created_by_name.$WORKSPACE_ID")"
  fi
fi

if [[ -z "$CREATED_BY_NAME_RESOLVED" ]]; then
  CREATED_BY_NAME_RESOLVED="$(
    printf '%s' "$catalog" | jq -r --arg k "$CREATED_BY_KIND" --arg id "$CREATED_BY_ID" '
      if $k == "squad" then
        ((.squads // [])[] | select(.id == $id) | .name) // $id
      else
        ((.agents // [])[] | select(.id == $id) | .name) // $id
      end
    '
  )"
fi

mqa_ws_set "$WORKSPACE_ID" created_by_kind "$CREATED_BY_KIND"
mqa_ws_set "$WORKSPACE_ID" created_by_id "$CREATED_BY_ID"
mqa_ws_set "$WORKSPACE_ID" created_by_name "$CREATED_BY_NAME_RESOLVED"

if [[ "$CONFIGURE" == "1" ]]; then
  msg="workspace=$WORKSPACE_ID project=${PROJECT_ID:-none} → $CREATED_BY_NAME_RESOLVED"
  if [[ "$NO_NOTIFY" == "1" ]]; then
    printf 'configured: %s\n' "$msg"
  else
    mqa_notify "Multica Quick Add configured" "$msg"
  fi
  exit 0
fi

# --- prompt ---
PROMPT=""
if [[ ${#PROMPT_ARGS[@]} -gt 0 ]]; then
  PROMPT="${PROMPT_ARGS[*]}"
elif [[ ! -t 0 ]]; then
  PROMPT="$(cat)"
  PROMPT="$(printf '%s' "$PROMPT" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
fi

if [[ -z "$PROMPT" ]]; then
  mqa_require_cmd walker
  hint="→ ${CREATED_BY_NAME_RESOLVED}"
  if [[ -n "$PROJECT_ID" ]]; then
    project_title="$(
      printf '%s' "$catalog" | jq -r --arg id "$PROJECT_ID" \
        '((.projects // [])[] | select(.id == $id) | .title // .name) // empty'
    )"
    [[ -n "$project_title" ]] && hint="$hint · $project_title"
  fi
  PROMPT="$(mqa_prompt_text "Describe an issue" "$hint")" || mqa_die "Cancelled."
fi

# --- attachments ---
attachment_ids=()
if ((${#ATTACHMENTS[@]} > 0)); then
  for path in "${ATTACHMENTS[@]}"; do
    [[ -n "$path" ]] || continue
    [[ -f "$path" ]] || mqa_die "Attachment not found: $path"
    id="$(mqa_upload_attachment "$WORKSPACE_ID" "$path")"
    [[ -n "$id" ]] || mqa_die "Upload failed for $path"
    attachment_ids+=("$id")
  done
fi

# --- submit ---
if ((${#attachment_ids[@]} > 0)); then
  mqa_quick_create "$WORKSPACE_ID" "$PROMPT" "$CREATED_BY_KIND" "$CREATED_BY_ID" "${PROJECT_ID:-}" "${attachment_ids[@]}"
else
  mqa_quick_create "$WORKSPACE_ID" "$PROMPT" "$CREATED_BY_KIND" "$CREATED_BY_ID" "${PROJECT_ID:-}"
fi
if [[ "$NO_NOTIFY" == "1" ]]; then
  printf 'sent to %s: %s\n' "$CREATED_BY_NAME_RESOLVED" "$PROMPT"
else
  mqa_notify "Sent to $CREATED_BY_NAME_RESOLVED" "$PROMPT"
fi
